# Copie para .env e preencha. Nunca commite o .env.

# --- Banco de dados ---
# Caminho do SQLite (relativo a backend/). Gerado por: python -m app.database.seed
DB_PATH=data/emporio.db

# --- Relógio ---
TIMEZONE=America/Campo_Grande
# Opcional: fixa a "data de hoje" do agente (ISO 8601). Útil para testes e para
# demonstrar regras que dependem de prazo (ex.: devolução em 7 dias).
# Exemplo: NOW_OVERRIDE=2026-03-23T10:00:00
NOW_OVERRIDE=

# --- LLM (Google Gemini) --- usado a partir da Etapa 4
GEMINI_API_KEY=
GEMINI_MODEL=
