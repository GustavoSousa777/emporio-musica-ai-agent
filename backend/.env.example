
DB_PATH=data/emporio.db

CONVERSATIONS_DB_PATH=data/conversations.db

TIMEZONE=America/Campo_Grande

NOW_OVERRIDE=

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

GEMINI_THINKING_LEVEL=


RAG_MODE=hybrid
RAG_INDEX_PATH=data/index/policies_index.json
# Modelos de embedding em ordem (cada um com cota própria) e dimensão do vetor
GEMINI_EMBEDDING_MODELS=gemini-embedding-001,gemini-embedding-2
GEMINI_EMBEDDING_DIMS=768

# API HTTP (uvicorn app.main:create_app --factory)
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Mensagens por minuto por IP em /chat (0 desliga)
RATE_LIMIT_PER_MINUTE=30
# Se preenchida, /chat exige o cabeçalho X-API-Key com este valor (/health continua aberto)
API_KEY=
# true quando a API roda atrás de um proxy que envia X-Forwarded-For
TRUST_PROXY=false
